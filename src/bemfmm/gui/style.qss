QMainWindow, QDialog {
    background: #f4f6f7;
}

QTabWidget::pane {
    border: none;
    border-top: 1px solid #d5dbdf;
}

QTabBar::tab {
    padding: 8px 16px;
    color: #4a5760;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #1f4f8f;
    border-bottom: 2px solid #1f4f8f;
}

QTabBar::tab:hover:!selected {
    color: #1c2226;
}

QGroupBox {
    border: 1px solid #d5dbdf;
    border-radius: 6px;
    margin-top: 16px;
    padding: 8px 6px 6px 6px;
    background: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #33404a;
}

QPushButton {
    padding: 4px 12px;
}

QPushButton:checked {
    background: #dbe6f5;
    border: 1px solid #1f4f8f;
    border-radius: 3px;
}

QPushButton#runButton {
    background: #1f4f8f;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 20px;
    font-weight: 600;
}

QPushButton#runButton:hover {
    background: #173f73;
}

QPushButton#runButton:disabled {
    background: #9fb0c8;
}

QProgressBar {
    border: 1px solid #c9d0d5;
    border-radius: 3px;
    background: #eef1f3;
    max-height: 8px;
}

QProgressBar::chunk {
    background: #1f4f8f;
}

QPlainTextEdit#logView {
    font-family: "JetBrains Mono", "Consolas", "Menlo", monospace;
    font-size: 9pt;
    background: #fbfbfb;
}

QLabel#stageLabel, QLabel#modelSummary, QLabel#tissueHint, QLabel#resultStats,
QLabel#electrodeSummary, QLabel#electrodeHint {
    color: #56626b;
}

QLabel#solveSummary {
    font-weight: 600;
    color: #1c2226;
    padding: 4px 0;
}

QLabel#noViewportLabel {
    color: #56626b;
    font-size: 11pt;
    padding: 40px;
}

QToolBar {
    border: none;
    border-bottom: 1px solid #d5dbdf;
    spacing: 4px;
    padding: 2px 6px;
}

QScrollArea#displayScroll, QWidget#displayContents {
    background: transparent;
}
